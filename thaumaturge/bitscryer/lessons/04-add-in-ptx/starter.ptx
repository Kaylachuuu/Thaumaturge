//! block 256
//
// Lesson 4: lesson 1 again (c[i] = a[i] + b[i]), written by hand in PTX, the card's assembly language.
//
// PTX is a little like a RISC assembly with unlimited registers: you declare as many as you want, of a type,
// and ptxas (BitScryer runs it each time you save) gives them real registers and turns it into SASS.

.version 7.0                // which edition of PTX this is written in
.target sm_70               // the oldest card it may run on (the V100); newer cards run it too
.address_size 64            // pointers are 64 bits

.visible .entry add(        // the kernel: its name, and its parameters
    .param .u64 a,          // the three pointers...
    .param .u64 b,
    .param .u64 c,
    .param .u32 n           // ...and the count
)
{
    .reg .pred  %p<2>;      // predicates (true/false): %p0, %p1
    .reg .b32   %r<8>;      // 32-bit registers: %r0 .. %r7
    .reg .b64   %rd<12>;    // 64-bit registers: %rd0 .. %rd11
    .reg .f32   %f<4>;      // float registers: %f0 .. %f3

    // 1. Load the parameters into registers:          ld.param.u64 %rd1, [a];   (and b, c, n)
    //    and turn the pointers into global addresses:  cvta.to.global.u64 %rd4, %rd1;

    // 2. i = blockIdx.x * blockDim.x + threadIdx.x.  The built-in values are special registers:
    //    %ctaid.x (blockIdx.x), %ntid.x (blockDim.x), %tid.x (threadIdx.x).  mov.u32 %r1, %ctaid.x;

    // 3. If i >= n, skip to the end:  setp.ge.s32 %p1, %r4, %r5;   @%p1 bra DONE;

    // 4. The byte offset of value i (4 bytes each), added to each address:  mul.wide.s32 %rd7, %r4, 4;

    // 5. Load a[i] and b[i], add them, store into c[i]:  ld.global.f32  add.f32  st.global.f32

DONE:
    ret;
}
